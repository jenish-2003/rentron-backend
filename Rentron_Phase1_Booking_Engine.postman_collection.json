    {
      "name": "7. Real-Time WebSockets & Notifications",
      "item": [
        {
          "name": "STOMP WebSocket Connection Endpoint",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "description": "Passed in STOMP CONNECT frame native headers"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ws-rentron",
              "host": ["{{baseUrl}}"],
              "path": ["ws-rentron"],
              "description": "Native WebSocket endpoint. Fallback SockJS endpoint: /ws-rentron-sockjs"
            }
          }
        },
        {
          "name": "Subscribe to Booking Lifecycle Topic",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/topic/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["topic", "booking", "{{bookingId}}"],
              "description": "STOMP Destination. Broadcasts BOOKING_CREATED, SEARCHING_DRIVER, DRIVER_ASSIGNED, ARRIVED, RIDE_STARTED, COMPLETED, CANCELLED, NO_DRIVER_AVAILABLE"
            }
          }
        },
        {
          "name": "Subscribe to Driver Dispatch Offers Topic",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/topic/booking-offers/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["topic", "booking-offers", "{{userId}}"],
              "description": "STOMP Destination for targeted driver ride offers. Also available via user queue: /user/queue/booking-offers"
            }
          }
        },
        {
          "name": "Subscribe to Admin Booking Alerts Topic",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/topic/admin/booking-alerts",
              "host": ["{{baseUrl}}"],
              "path": ["topic", "admin", "booking-alerts"],
              "description": "STOMP Destination for unassigned / manual escalation alerts"
            }
          }
        }
      ]
    }
  ]
}
