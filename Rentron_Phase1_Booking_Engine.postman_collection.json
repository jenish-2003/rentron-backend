              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"bookingType\": \"LOCAL_RIDE\",\n  \"pickupLatitude\": 12.9716,\n  \"pickupLongitude\": 77.5946,\n  \"dropLatitude\": 12.9352,\n  \"dropLongitude\": 77.6245,\n  \"pickupAddress\": \"MG Road, Bangalore\",\n  \"destinationAddress\": \"Koramangala, Bangalore\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/quote",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings", "quote"]
            }
          }
        },
