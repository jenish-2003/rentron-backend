            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"bookingType\": \"LOCAL\",\n  \"paymentMethod\": \"CASH\",\n  \"distanceKm\": 8.5,\n  \"durationHours\": 0.4,\n  \"pickupAddressText\": \"MG Road Metro Station\",\n  \"destinationAddressText\": \"Indiranagar 100ft Road\",\n  \"pickupLatitude\": 12.9756,\n  \"pickupLongitude\": 77.6066,\n  \"dropLatitude\": 12.9784,\n  \"dropLongitude\": 77.6408,\n  \"idempotencyKey\": \"req-uuid-1001\"\n}"
            },
